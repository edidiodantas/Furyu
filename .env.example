# =============================================================================
# IPeia Acadêmico — configuração (.env)
# Copie para .env e ajuste. Nunca envie o .env para o GitHub (já está no .gitignore).
# =============================================================================

# --- IA que lê e escreve (LLM) -----------------------------------------------
# Provedores: ollama | openai_compatible | openai | anthropic | gemini | openrouter
LLM_PROVIDER=ollama

# Nome do modelo no provedor (o prefixo do LiteLLM é adicionado sozinho).
# Exemplos:
#   ollama ............. qwen3.5:4b  |  llama3.2:3b  |  qwen2.5:14b
#   openai_compatible .. nome do modelo carregado no LM Studio / vLLM
#   openai ............. o nome do modelo na sua conta OpenAI
#   anthropic .......... claude-opus-5-5  |  claude-sonnet-5-5  |  claude-haiku-5-5
#   gemini / openrouter  o nome do modelo no provedor
LLM_MODEL=qwen3.5:4b

# Endereço do servidor. Ollama: http://localhost:11434 (padrão).
# openai_compatible: obrigatório, ex.: http://localhost:1234/v1 (LM Studio).
# Provedores na nuvem: deixe vazio.
LLM_API_BASE=

# Opcional: modelo mais barato/rápido só para resumir os trechos (mesmo provedor).
SUMMARY_LLM_MODEL=

# Opcional: 0 a 2. Vazio = 0 no Ollama e "não enviar" nos demais
# (os modelos Claude atuais recusam este parâmetro).
LLM_TEMPERATURE=

# Chaves de API: preencha SÓ a do provedor escolhido. Ollama não precisa.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Embeddings (busca dos trechos) ------------------------------------------
# Trocar o embedding exige reindexar o acervo (o app avisa).
#   st-multi-qa-MiniLM-L6-cos-v1 ... local, leve, melhor em inglês (padrão)
#   ollama/bge-m3 .................. local via Ollama, multilíngue (bom para português)
#   text-embedding-3-small ......... OpenAI (nuvem, precisa de OPENAI_API_KEY)
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1
# Opcional: servidor do embedding (para ollama/... o padrão é o mesmo do LLM).
EMBEDDING_API_BASE=

# --- Respostas ---------------------------------------------------------------
ANSWER_LANGUAGE=português do Brasil
# Tamanho pedido à IA. Modelos maiores aguentam textos longos.
ANSWER_LENGTH=cerca de 300 palavras
# Quantos trechos são lidos por pergunta e quantas fontes no máximo na resposta.
EVIDENCE_K=10
ANSWER_MAX_SOURCES=5

# Citação ABNT: a NBR 10520:2023 usa (Silva, 2020). Para (SILVA, 2020), use true.
CITATION_UPPERCASE=false

# --- Pastas ------------------------------------------------------------------
PDF_DIR=./documentos
PQA_HOME=./.pqa

# --- Busca de artigos --------------------------------------------------------
# Seu e-mail real. Só é enviado ao Unpaywall/Crossref para achar PDFs abertos.
CONTACT_EMAIL=
# Opcional: chave grátis em https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
