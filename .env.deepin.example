# Deepin (GTX 750 4 GB, GPU antiga; o Ollama tende a usar CPU)
OLLAMA_MODEL=qwen3.5:4b

# URL do servidor Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Pasta onde os artigos e livros enviados são salvos
PDF_DIR=./documentos

# Cache e índice do acervo. O setup-deepin.sh aponta isto para linux-env/pqa
PQA_HOME=./.pqa

# Embedding local via sentence-transformers (NÃO usa OpenAI)
# Prefixo "st-" = modelo HuggingFace local (paper-qa[local])
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1

# Idioma em que a IA deve responder
ANSWER_LANGUAGE=português do Brasil

# Não defina OPENAI_API_KEY. Ollama não precisa de chave.

# Seu e-mail real. Só é enviado ao Unpaywall/Crossref para achar PDFs abertos.
# Deixe vazio se não quiser usar o Unpaywall. Placeholders de exemplo são ignorados.
CONTACT_EMAIL=

# Opcional: chave grátis em https://www.semanticscholar.org/product/api
# Sem chave a busca pública funciona, mas tem limite por minuto.
SEMANTIC_SCHOLAR_API_KEY=
